# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app (they are not secrets).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# RevenueCat public SDK keys (Project settings → API keys)
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_xxx
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_xxx
# Where the web build (customer portal) is hosted, e.g. https://skyshine.expo.app
EXPO_PUBLIC_PORTAL_URL=https://your-portal-domain
EXPO_PUBLIC_PRIVACY_URL=https://your-domain/privacy
EXPO_PUBLIC_TERMS_URL=https://your-domain/terms
EXPO_PUBLIC_SUPPORT_EMAIL=support@your-domain
