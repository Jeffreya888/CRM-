{
  "expo": {
    "name": "SkyShine",
    "slug": "skyshine-crm",
    "scheme": "skyshine",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B3D91"
    },
    "ios": {
      "bundleIdentifier": "com.yourcompany.skyshine",
      "buildNumber": "1",
      "supportsTablet": true,
      "config": { "usesNonExemptEncryption": false },
      "infoPlist": {
        "NSCameraUsageDescription": "SkyShine uses the camera to take before, after and damage photos of aircraft on each job.",
        "NSPhotoLibraryUsageDescription": "SkyShine lets you attach existing photos to jobs and aircraft profiles.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yourcompany.skyshine",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B3D91",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["CAMERA", "com.android.vending.BILLING"],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "SkyShine uses the camera to take before, after and damage photos of aircraft on each job.",
          "photosPermission": "SkyShine lets you attach existing photos to jobs and aircraft profiles."
        }
      ],
      ["expo-notifications", { "color": "#0B3D91" }],
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": { "projectId": "" }
    }
  }
}
