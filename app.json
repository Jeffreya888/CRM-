{
  "expo": {
    "name": "Tarmo",
    "slug": "tarmo",
    "scheme": "tarmo",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#131926"
    },
    "ios": {
      "bundleIdentifier": "com.flightready.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Tarmo uses the camera to take before, after and damage photos of aircraft on each job.",
        "NSPhotoLibraryUsageDescription": "Tarmo lets you attach existing photos to jobs and aircraft profiles.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSFaceIDUsageDescription": "Tarmo uses Face ID to lock the app so customer details and gate codes stay private."
      },
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.flightready.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#131926",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "com.android.vending.BILLING"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Tarmo uses the camera to take before, after and damage photos of aircraft on each job.",
          "photosPermission": "Tarmo lets you attach existing photos to jobs and aircraft profiles."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#4698E1"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Tarmo uses the camera for job photos and to scan supply barcodes and equipment QR labels.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Tarmo uses Face ID to lock the app so customer details and gate codes stay private."
        }
      ],
      "expo-apple-authentication",
      "./modules/square-mobile-payments/app.plugin.js"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}
