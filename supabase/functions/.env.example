# Set with: supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY are provided automatically.)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
REVENUECAT_WEBHOOK_SECRET=long-random-string
CRON_SECRET=another-long-random-string
RESEND_API_KEY=re_xxx
EMAIL_FROM=Flight Ready <billing@your-domain.com>
PORTAL_URL=https://your-portal-domain
# Optional platform fee overrides in basis points (150 = 1.5%)
PLATFORM_FEE_BPS_SOLO=150
PLATFORM_FEE_BPS_TEAM=100
PLATFORM_FEE_BPS_FLEET=50
PLATFORM_FEE_BPS_TRIAL=150
# Payments (care plans): signing secret of the Stripe "Connected accounts" webhook endpoint
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxx
# Receipt scanning (scan-receipt) — Claude API key
ANTHROPIC_API_KEY=sk-ant-xxx
# Optional: max MB of photos/files included in an owner data export ZIP (default 150)
EXPORT_PHOTO_MAX_MB=150
