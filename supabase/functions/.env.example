# Set with: supabase secrets set --env-file supabase/functions/.env
# (SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY are provided automatically.)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
REVENUECAT_WEBHOOK_SECRET=long-random-string
CRON_SECRET=another-long-random-string
RESEND_API_KEY=re_xxx
EMAIL_FROM=Flight Ready <billing@your-domain.com>
PORTAL_URL=https://your-portal-domain
# Optional platform fee overrides in basis points (150 = 1.5%)
PLATFORM_FEE_BPS_SOLO=150
PLATFORM_FEE_BPS_TEAM=100
PLATFORM_FEE_BPS_FLEET=50
PLATFORM_FEE_BPS_TRIAL=150
# Payments (care plans): signing secret of the Stripe "Connected accounts" webhook endpoint
STRIPE_CONNECT_WEBHOOK_SECRET=whsec_xxx
# Claude API key: receipt scanning (scan-receipt) and AI photo condition reports (assess-photos, portal photo quotes)
ANTHROPIC_API_KEY=sk-ant-xxx
# Optional: max MB of photos/files included in an owner data export ZIP (default 150)
EXPORT_PHOTO_MAX_MB=150
# Email (Resend): EMAIL_FROM above must be on a domain verified in Resend. Company emails go out as
# "Company via Flight Ready <that address>" with Reply-To = the company email.
# Signing secret of the Resend webhook (resend-webhook): Resend → Webhooks → endpoint → Signing secret
RESEND_WEBHOOK_SECRET=whsec_xxx
# Where "texting number requested" and other platform requests are emailed
SUPPORT_EMAIL=support@your-domain.com
# Customer texting (Telnyx, platform-run account). Messaging profile webhook → /functions/v1/telnyx-webhook
TELNYX_API_KEY=KEYxxx
TELNYX_MESSAGING_PROFILE_ID=40017xxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Telnyx portal → Keys & Credentials → Public Key (base64) — verifies webhook signatures
TELNYX_PUBLIC_KEY=base64-public-key
# Optional: texting provider (only "telnyx" today; the code is provider-swappable)
SMS_PROVIDER=telnyx
# Optional: UTC hour after which automation-worker runs the once-a-day maintenance (default 12 ≈ 7-8 AM US Eastern)
DAILY_HOUR_UTC=12
